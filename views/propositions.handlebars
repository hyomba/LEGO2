<h2>Propositions</h2>

<ul>
    {{#each proposition}}
        <li>
            <div>{{this.nom_echange}}</div>
            <div>{{this.nom}}, {{this.prenom}}</div>

            {{#if user}}
                 <div><a href="/proposition/{{this.id_proposition}}">Voir la proposition</a></div>
            {{/if}}
        </li>
    {{/each}}
</ul>

{{#unless user}}
  <div class="colle-bas">
     <a href="/proposition">Créer une proposition</a>
  <div>
{{/unless}}