<h2>Échanges</h2>

<ul>
    {{#each echanges}}
        <li>
            <div>{{this.nom_echange}}</div>
            <div>{{this.nom}}, {{this.prenom}}</div>

            {{#if user}}
                 <div><a href="/echange/{{this.id_echange}}">Voir l'échange</a></div> 
            {{/if}}
        </li>
    {{/each}}

</ul>

{{#if user}}
  <div class="colle-bas">
     <a href="/echange">Créer un échange</a>
  <div>
{{/if}}