<h2>Voir tous les propositions</h2>

<ul>
    {{#each echanges}}
        <li>
            <div>{{this.nom_echange}}</div>
            <div>{{this.nom}}, {{this.prenom}}</div>

            {{#if user}}
                 <div><a href="/echange/{{this.id_echange}}">Voir la proposition</a></div>
            {{/if}}
        </li>
    {{/each}}
</ul>

{{#if user}}
  <div class="colle-bas">
     <a href="/proposition">Créer une proposition</a>
  <div>
{{/if}}