 <h2>Inscription</h2>

<form id="new-compte" >
     <div class="form-group">
        <input type="nom" id="input-nom" placeholder="Nom" required>
    </div>

    <div class="form-group">
        <input type="prenom" id="input-prenom" placeholder="Prénom" required>
    </div>
    <div class="form-group">
        <input type="email" id="input-courriel" placeholder="Adresse e-mail" required>
    </div>

    <div class="form-group">
        <input type="password" id="input-motdepasse" placeholder="Mot de passe" required minlength="8" maxlength="100">
    </div>

    <div >
        <input type="submit" value="Inscription">
    </div>
    <div id="erreur-auth"></div>
</form>

