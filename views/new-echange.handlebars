<h2>Créer un échange</h2>

<form id="new-echange" novalidate>
    <ul class="briques">
        {{#each briques}}
            <li>
                <img src="/assets/{{this.image}}" alt="{{this.nom}}" />
                <div class="nom">{{this.nom}}</div>
                <div class="couleur">Couleur <div>{{this.couleur}}</div></div>
                <div class="valeur">Valeur <div>{{this.valeur}}</div></div>
                <input type="number" value="0" data-id="{{this.id_brique}}">
            </li>
        {{/each}}
    </ul>

    <div class="colle-bas">
        <input type="text" name="nom" placeholder="Nom de l'échange" required minlength="10" maxlength="100">
        <input type="submit" value="Créer l'échange">
    </div>
</form>
